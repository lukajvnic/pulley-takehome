generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  pm
  designer
  engineer
  consultant
}

enum ApprovalStatus {
  preparing
  submitted
  comments
  approved
}

enum DocumentKind {
  required_upload
  response_letter // generated when a response is submitted
}

enum DocumentStatus {
  needed
  uploaded
}

enum DocumentType {
  submittal
  comment_letter
}

enum ParseStatus {
  processing
  done
  failed
}

enum CommentType {
  correction
  informational
  administrative
}

model User {
  id               String          @id @default(cuid())
  name             String
  email            String          @unique
  role             UserRole
  memberships      ProjectMember[]
  assignedComments Comment[]       @relation("CommentAssignees")
}

model Project {
  id        String          @id @default(cuid())
  name      String
  address   String
  ahjName   String
  createdAt DateTime        @default(now())
  members   ProjectMember[]
  permits   Permit[]
}

model ProjectMember {
  id        String  @id @default(cuid())
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id])
  user      User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
}

model Permit {
  id           String     @id @default(cuid())
  projectId    String
  name         String
  permitNumber String?
  project      Project    @relation(fields: [projectId], references: [id])
  approvals    Approval[]
}

model Approval {
  id          String         @id @default(cuid())
  permitId    String
  name        String
  status      ApprovalStatus @default(preparing)
  submittedAt DateTime?
  approvedAt  DateTime?
  permit      Permit         @relation(fields: [permitId], references: [id])
  documents   Document[]
  submissions Submission[]
}

// One package sent to the jurisdiction, holding the files that went out.
// Submission 1 is the initial submittal; the jurisdiction's review N looks at
// submission N, and its comment letter (round N) is answered by submission N + 1.
model Submission {
  id          String              @id @default(cuid())
  approvalId  String
  number      Int
  submittedAt DateTime
  approval    Approval            @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  documents   SubmittalDocument[]

  @@unique([approvalId, number])
}

// Base table for every file attached to an approval. `type` says which subtype
// table (SubmittalDocument or CommentLetter) holds the rest of its fields.
model Document {
  id            String             @id @default(cuid())
  approvalId    String
  name          String
  type          DocumentType
  filePath      String?
  uploadedAt    DateTime?
  approval      Approval           @relation(fields: [approvalId], references: [id])
  submittal     SubmittalDocument?
  commentLetter CommentLetter?
}

// A file the team submits to the jurisdiction (the package checklist, and files
// referenced from comment responses).
model SubmittalDocument {
  documentId   String         @id
  kind         DocumentKind   @default(required_upload)
  status       DocumentStatus @default(needed)
  submissionId String? // the submission it went out with; null until submitted
  document     Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  submission   Submission?    @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  comments     Comment[]
}

// A comment letter from the jurisdiction's review N (its `round`), on submission N.
model CommentLetter {
  documentId   String      @id
  round        Int
  letterDate   DateTime?
  reviewerName String?
  parseStatus  ParseStatus @default(processing)
  parseError   String?
  document     Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  comments     Comment[]
}

model Comment {
  id          String              @id @default(cuid())
  letterId    String
  number      String // as printed on the letter: "4", "A-1", "TE 1"
  position    Int // order within the letter
  discipline  String?
  title       String? // short summary written by the parser
  text        String
  sheetRefs   String[]
  codeRefs    String[]
  commentType CommentType         @default(correction)
  response    String?
  completed   Boolean             @default(false)
  letter      CommentLetter       @relation(fields: [letterId], references: [documentId], onDelete: Cascade)
  assignees   User[]              @relation("CommentAssignees")
  attachments SubmittalDocument[]
}
