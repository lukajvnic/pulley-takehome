{
  "name": "pulley-agentic-onsite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/db.ts npx next dev",
    "build": "next build",
    "start": "tsx scripts/db.ts npx next start",
    "lint": "eslint",
    "db": "tsx scripts/db.ts",
    "db:migrate": "tsx scripts/db.ts npx prisma migrate dev",
    "db:seed": "tsx scripts/db.ts npx prisma db seed",
    "db:reset": "tsx scripts/db.ts npx prisma migrate reset --force",
    "setup": "tsx scripts/db.ts npx prisma migrate deploy && tsx scripts/db.ts npx prisma generate && tsx scripts/db.ts npx prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@react-pdf/renderer": "^4.9.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "next": "16.3.0",
    "openai": "^7.27.0",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-pdf": "^11.0.0",
    "tsx": "^4.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
